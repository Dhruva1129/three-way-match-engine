# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/three_way_match

# Auth (mock — no real identity provider)
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=12h

# Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15

# CORS
FRONTEND_ORIGIN=http://localhost:3000
